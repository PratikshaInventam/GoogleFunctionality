# --------------------------------------------------
# React Native & Node.js .gitignore
# --------------------------------------------------

# OSX / macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# Node modules & Package manager logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.pnp
.pnp.js

# Environment variables & secrets
.env
.env*.local
*.pem
*.key

# Metro & Bundler
.metro/
.expo/
*.jsbundle
*.bundle

# Build directories & outputs
build/
dist/
coverage/
.nyc_output/

# --------------------------------------------------
# Android
# --------------------------------------------------
android/app/build/
android/build/
android/.gradle/
android/.kotlin/
android/captures/
android/local.properties
android/app/.cxx/
android/.cxx/

# Android Studio & IntelliJ
android/.idea/
.idea/
*.iml
*.ipr
*.iws

# Android Keystores & release keys (uncomment if you want to ignore keystores)
*.keystore
!android/app/debug.keystore
*.jks

# --------------------------------------------------
# iOS & Xcode
# --------------------------------------------------
ios/build/
ios/Pods/
ios/DerivedData/
ios/.xcode.env.local

# Xcode User Data & State
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate

# --------------------------------------------------
# Ruby / Bundler / Fastlane
# --------------------------------------------------
.bundle/
vendor/bundle/
vendor/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# --------------------------------------------------
# Editors & IDEs
# --------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
